# ---------------------------------------------------------------------------
# Teams Notes - local configuration
#
# Copy this file to ".env" and edit. ".env" is gitignored and must never be
# committed. Every value below is optional; the defaults are tuned for a
# CPU-only Windows laptop with 16GB RAM.
# ---------------------------------------------------------------------------

# --- Hugging Face (needed for speaker diarization only) ---------------------
# Free account: https://huggingface.co/join
# Create a READ token:  https://huggingface.co/settings/tokens
# You must also accept the model terms once, while signed in:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# Leave this blank to run without diarization (transcript will be unattributed).
HF_TOKEN=

# --- Transcription (faster-whisper) -----------------------------------------
# small.en  -> fast, comfortably real-time on CPU (default)
# medium.en -> more accurate, noticeably slower on CPU
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8
# Number of CPU threads Whisper may use. 0 = let the library decide.
WHISPER_CPU_THREADS=0

# --- Diarization (pyannote.audio) -------------------------------------------
DIARIZATION_ENABLED=true
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Optional hints; leave blank to let pyannote decide the speaker count.
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=

# --- Local LLM (Ollama) ------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# qwen2.5:7b-instruct  -> ~5GB RAM, good quality (default)
# llama3.2:3b          -> lighter and faster, lower quality
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=600
# Context window handed to the model. Larger = more RAM.
OLLAMA_NUM_CTX=8192

# --- Audio capture -----------------------------------------------------------
# Final mixed audio is always 16 kHz mono (what Whisper wants).
CAPTURE_SAMPLE_RATE=16000
# Relative gain applied when mixing. 1.0 = unchanged.
MIC_GAIN=1.0
LOOPBACK_GAIN=1.0
# Substring match to pick a specific input device; blank = system default.
MIC_DEVICE_NAME=
LOOPBACK_DEVICE_NAME=
# Keep the separate microphone / loopback tracks after mixing (uses more disk).
KEEP_RAW_TRACKS=true

# --- Dashboard ---------------------------------------------------------------
# The dashboard always binds to loopback only and is never exposed to the LAN.
WEB_HOST=127.0.0.1
WEB_PORT=8765
# Open the dashboard in the browser when the tray app starts.
OPEN_BROWSER_ON_START=false

# --- Hands-free meeting detection (Phase 6) ---------------------------------
AUTO_DETECT_ENABLED=true
# Process names that count as "Teams" for auto-detection (comma separated).
TEAMS_PROCESS_NAMES=Teams.exe,ms-teams.exe
# How long Teams audio must be active before a recording starts.
AUTO_START_AFTER_SECONDS=10
# How long Teams audio must be silent/inactive before the recording stops.
AUTO_STOP_AFTER_SECONDS=45
# Recordings shorter than this are discarded (ringtones, accidental clicks).
AUTO_MIN_MEETING_SECONDS=60

# --- Storage / retention -----------------------------------------------------
# Delete audio files older than this many days. 0 = keep forever.
AUDIO_RETENTION_DAYS=0

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
